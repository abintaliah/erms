# Copy to .env for local development. Process environment variables override it.
DATABASE_URL=postgresql://erms:replace-with-a-secure-password@127.0.0.1:5432/erms
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10
CONTENT_STORAGE_BACKEND=postgresql
MAX_UPLOAD_SIZE_BYTES=52428800
WEBUI_API_URL=http://127.0.0.1:8000
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_RELOAD=false
DASHBOARD_RECENT_ITEM_LIMIT=4
DASHBOARD_RECENT_DAYS=30

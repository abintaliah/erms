# Copy to .env for local development. Process environment variables override it.
DATABASE_URL=postgresql://erms:replace-with-a-secure-password@127.0.0.1:5432/erms
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10
CONTENT_STORAGE_BACKEND=postgresql
MAX_UPLOAD_SIZE_BYTES=52428800
CONTENT_SEGMENT_SIZE_BYTES=16777216
CONTENT_SEGMENT_CHECKSUMS_ENABLED=true
CONTENT_UPLOAD_SESSION_TTL_SECONDS=86400
CONTENT_CLEANUP_INTERVAL_SECONDS=3600
AUTH_SESSION_RETENTION_DAYS=90
AUTH_SESSION_CLEANUP_INTERVAL_SECONDS=3600
AUTH_SESSION_CLEANUP_BATCH_SIZE=500
WEBUI_API_URL=http://127.0.0.1:8000
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_RELOAD=false
TEXT_INDEXER_ENABLED=false
CONTENT_INDEXING_SCHEDULING_ENABLED=false
CONTENT_INDEXING_MAINTENANCE_ENABLED=true
CONTENT_INDEXING_HISTORY_RETENTION_DAYS=365
CONTENT_INDEXING_CLEANUP_INTERVAL_SECONDS=3600
CONTENT_INDEXING_CLEANUP_BATCH_SIZE=500
FULL_TEXT_SEARCH_ENABLED=false
WEBUI_FULL_TEXT_SEARCH_ENABLED=false
TEXT_INDEXER_API_URL=http://127.0.0.1:8000
# An empty key tells run-local-stack.sh to provision locally and load the generated file below.
TEXT_INDEXER_API_KEY=
TEXT_INDEXER_API_KEY_FILE=.secrets/text-indexer-api-key
TEXT_INDEXER_TIKA_HOME=vendor/tika
TEXT_INDEXER_CLAIM_BATCH_SIZE=1
TEXT_INDEXER_PROCESS_COUNT=2
TEXT_INDEXER_POLL_SECONDS=5
TEXT_INDEXER_HEARTBEAT_SECONDS=60
TEXT_INDEXER_EXTRACTION_TIMEOUT_SECONDS=120
TEXT_INDEXER_MAX_INPUT_BYTES=52428800
TEXT_INDEXER_MAX_EXTRACTED_CHARACTERS=5000000
TEXT_INDEXER_CHUNK_TARGET_CHARACTERS=16000
TEXT_INDEXER_CHUNK_MAX_CHARACTERS=20000
TEXT_INDEXER_MAX_PAGES=1000
TEXT_INDEXER_MAX_TEMP_BYTES=1073741824
TEXT_INDEXER_TEMP_DIR=/tmp/wathiq-text-indexer
TEXT_INDEXER_STALE_TEMP_HOURS=24
TEXT_INDEXER_TEMP_SWEEP_LIMIT=100
TEXT_INDEXER_RATE_LIMIT_PER_MINUTE=600
# API-side maintenance retention; this is not a text-indexer worker setting.
TEXT_INDEXER_CREDENTIAL_HISTORY_RETENTION_DAYS=365
SEARCH_RATE_LIMIT_PER_MINUTE=600
MANUAL_REINDEX_RATE_LIMIT_PER_MINUTE=60
DASHBOARD_RECENT_ITEM_LIMIT=4
DASHBOARD_RECENT_DAYS=30
DASHBOARD_REVIEW_PREVIEW_LIMIT=5
REVIEW_WARNING_WINDOW_DAYS=30
DEFAULT_ROOT_AGGREGATION_MEDIUM=mixed
CLASSIFICATION_RECENT_SELECTION_LIMIT=4

# Install as /etc/erms/api.env and replace the database credentials.
# Loopback assumes a local proxy/UI. Use a private binding for remote peers.
DATABASE_URL=postgresql://erms:REPLACE_PASSWORD@127.0.0.1:5432/erms
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10
CONTENT_STORAGE_BACKEND=postgresql
MAX_UPLOAD_SIZE_BYTES=52428800
AUTH_COOKIE_SECURE=true
